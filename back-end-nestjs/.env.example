# ---- Server ----
PORT=8080
# development | production (development enables TypeORM schema sync and SQL logging)
NODE_ENV=development

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aie

# ---- Authentication ----
# Required. Use a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=your_jwt_secret_here

# ---- gov.br OpenID Connect login (optional) ----
# Leave GOVBR_CLIENT_ID / GOVBR_CLIENT_SECRET empty to disable gov.br login.
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_BASE_URL=https://sso.acesso.gov.br
GOVBR_API_BASE_URL=https://api.acesso.gov.br
GOVBR_REDIRECT_URI=http://localhost:8080/retornoWebHook
GOVBR_FRONTEND_ORIGIN=http://localhost:3000
GOVBR_SCOPE=openid email profile
# Optional overrides
GOVBR_AUTH_URL=
GOVBR_TOKEN_URL=
GOVBR_USERINFO_URL=
GOVBR_BASIC_AUTH=
GOVBR_STATE_SECRET=
